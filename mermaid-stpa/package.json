{
  "name": "mermaid-stpa",
  "version": "0.1.0",
  "description": "STPA control-structure diagram type for Mermaid, registered as an external diagram.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "mermaid": "^12.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
